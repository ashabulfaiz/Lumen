# ─────────────────────────────────────────────────────────────
# API server (Node.js + Express)
# ─────────────────────────────────────────────────────────────
PORT=5000

# MySQL database (local dev defaults shown)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lumen

# Auth — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Internal services the API server calls (no trailing slash).
# In production set these to the deployed Railway service URLs.
AI_SERVICE_URL=http://localhost:5003
DS_SERVICE_URL=http://localhost:5002

# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — must be set at BUILD time on Vercel
# ─────────────────────────────────────────────────────────────
# Node API base, MUST include the /api suffix
VITE_API_URL=http://localhost:5000/api
# Unified AI service base (grammar + essay + chat), NO /api suffix
VITE_GRAMMAR_API_URL=http://localhost:5003
