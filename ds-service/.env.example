# Data Science service — connects READ-ONLY to the same MySQL as the API server.
# Use the SAME database credentials as the root .env (in production: the Railway DB).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lumen

# Local port. On Railway the platform injects PORT automatically.
DS_PORT=5002
