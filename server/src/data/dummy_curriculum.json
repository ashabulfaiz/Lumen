            "judul_lesson": "Greetings and Introductions",
            "konten_teks": "[\r\n  {\r\n    \"level\": \"Beginner\",\r\n    \"module_name\": \"Greetings and Introductions\",\r\n    \"sub_topic_title\": \"Saying Hello & Goodbye (Formal vs Informal)\",\r\n    \"objective\": \"In this lesson, you will learn various ways to say hello and goodbye, and understand when to use formal and informal language.\",\r\n    \"vocabulary\": [\r\n      { \"term\": \"Good morning / afternoon / evening\", \"meaning\": \"Selamat pagi / siang / malam (Formal)\" },\r\n      { \"term\": \"Hello / Hi / Hey\", \"meaning\": \"Halo (Informal)\" },\r\n      { \"term\": \"Goodbye / Have a nice day\", \"meaning\": \"Selamat tinggal / Semoga harimu menyenangkan (Formal)\" },\r\n      { \"term\": \"Bye / Catch you later\", \"meaning\": \"Dadah / Sampai ketemu lagi nanti (Informal)\" }\r\n    ],\r\n    \"concept\": \"Use formal greetings at work, at school (to teachers), or when speaking with people you do not know. Use informal greetings for peers or family. Common mistake: Never use 'Good night' to greet someone in the evening. 'Good night' is only used as a farewell or right before sleeping.\",\r\n    \"example_dialogue\": \"[Formal]\\nA: Good evening, Mr. Davis.\\nB: Good evening, Anna. Have a safe trip home.\\n\\n[Informal]\\nA: Hey, Mark! What's up?\\nB: Hi, John! Not much. I have to go now. Catch you later!\"\r\n  },\r\n  {\r\n    \"level\": \"Beginner\",\r\n    \"module_name\": \"Greetings and Introductions\",\r\n    \"sub_topic_title\": \"Asking 'How are you?'\",\r\n    \"objective\": \"You will learn various ways to ask how someone is doing and how to respond to it, from very good to not so good conditions.\",\r\n    \"vocabulary\": [\r\n      { \"term\": \"How are you? / How is it going?\", \"meaning\": \"Apa kabar? / Bagaimana kabarmu?\" },\r\n      { \"term\": \"I'm doing well / Great\", \"meaning\": \"Saya baik-baik saja / Luar biasa\" },\r\n      { \"term\": \"Not bad / So-so\", \"meaning\": \"Lumayan / Biasa saja\" },\r\n      { \"term\": \"And you? / How about you?\", \"meaning\": \"Dan kamu? / Bagaimana denganmu?\" }\r\n    ],\r\n    \"concept\": \"In Western culture, 'How are you?' is often just friendly small talk. People usually expect a short and positive answer. Politeness rule: Always add 'Thank you' after answering, then ask the same question back.\",\r\n    \"example_dialogue\": \"A: Hi, Sarah. How is it going?\\nB: Not bad, thanks! How about you?\\nA: I'm doing well, just a bit tired today.\"\r\n  },\r\n  {\r\n    \"level\": \"Beginner\",\r\n    \"module_name\": \"Greetings and Introductions\",\r\n    \"sub_topic_title\": \"Introducing Yourself\",\r\n    \"objective\": \"You will learn how to form complete sentences to state your identity, origin, age, and occupation or status.\",\r\n    \"vocabulary\": [\r\n      { \"term\": \"First name / Last name\", \"meaning\": \"Nama depan / Nama belakang\" },\r\n      { \"term\": \"Live in... / Come from...\", \"meaning\": \"Tinggal di... / Berasal dari...\" },\r\n      { \"term\": \"Years old\", \"meaning\": \"Tahun (untuk menyebutkan umur)\" },\r\n      { \"term\": \"Pleased to meet you\", \"meaning\": \"Senang bertemu denganmu\" }\r\n    ],\r\n    \"concept\": \"Use 'I am from [Country/City]' for your place of origin, and 'I live in [City]' for your current residence. Age rule: In English, we use the verb 'To Be' (am/is/are) for age, NOT 'have'. (Correct: I am 20 years old. Incorrect: I have 20 years).\",\r\n    \"example_dialogue\": \"Hello everyone. Let me introduce myself. My name is Kevin. I am from Indonesia, but I live in Tokyo now. I am 22 years old and I am a university student. Pleased to meet you all.\"\r\n  },\r\n  {\r\n    \"level\": \"Beginner\",\r\n    \"module_name\": \"Greetings and Introductions\",\r\n    \"sub_topic_title\": \"Introducing Others\",\r\n    \"objective\": \"You will learn how to act as a polite intermediary when introducing two people who do not know each other.\",\r\n    \"vocabulary\": [\r\n      { \"term\": \"This is...\", \"meaning\": \"Ini adalah...\" },\r\n      { \"term\": \"I'd like you to meet...\", \"meaning\": \"Saya ingin kamu bertemu dengan...\" },\r\n      { \"term\": \"Colleague / Coworker\", \"meaning\": \"Rekan kerja\" },\r\n      { \"term\": \"Classmate\", \"meaning\": \"Teman sekelas\" }\r\n    ],\r\n    \"concept\": \"Use 'This is [Name]'. If you point at your friend and say 'She is Maria' while she is right in front of you, it is considered less polite grammatically. Always mention your relationship with the person to make the introduction warmer.\",\r\n    \"example_dialogue\": \"A: Hi, David. I'd like you to meet my coworker, Lisa.\\nDavid: Hello, Lisa. Nice to meet you.\\nLisa: Nice to meet you too, David. I've heard a lot about you.\"\r\n  },\r\n  {\r\n    \"level\": \"Beginner\",\r\n    \"module_name\": \"Greetings and Introductions\",\r\n    \"sub_topic_title\": \"Using Titles Correctly\",\r\n    \"objective\": \"You will learn how to use English titles correctly so as not to offend the person you are speaking with.\",\r\n    \"vocabulary\": [\r\n      { \"term\": \"Mr. (Mister)\", \"meaning\": \"Untuk pria dewasa (menikah atau belum)\" },\r\n      { \"term\": \"Mrs. (Missus) / Miss\", \"meaning\": \"Untuk wanita menikah / Untuk wanita belum menikah\" },\r\n      { \"term\": \"Ms. (Mizz)\", \"meaning\": \"Untuk wanita (netral, tidak perlu tahu status pernikahannya)\" },\r\n      { \"term\": \"Sir / Ma'am\", \"meaning\": \"Pak / Bu (Panggilan hormat jika tidak tahu namanya)\" }\r\n    ],\r\n    \"concept\": \"Titles (Mr./Mrs./Ms./Miss) MUST be followed by the Last Name, not the first name. If his name is Budi Santoso, call him Mr. Santoso. In English-speaking countries, students DO NOT call their teacher by saying 'Teacher', but rather use the title and their last name.\",\r\n    \"example_dialogue\": \"[At a restaurant]\\nWaiter: Excuse me, Sir. Is this your bag?\\n\\n[At school]\\nStudent: Good morning, Mrs. Robinson. How are you?\\nTeacher: Good morning. Please take a seat.\"\r\n  },\r\n  {\r\n    \"level\": \"Beginner\",\r\n    \"module_name\": \"Greetings and Introductions\",\r\n    \"sub_topic_title\": \"Subject Pronouns (Basic Grammar)\",\r\n    \"objective\": \"Understand personal pronouns as the subject (doer) in a sentence. This is an absolute foundation before making any sentences.\",\r\n    \"vocabulary\": [\r\n      { \"term\": \"I / You\", \"meaning\": \"Saya / Kamu (atau Kalian)\" },\r\n      { \"term\": \"He / She / It\", \"meaning\": \"Dia (Laki-laki) / Dia (Perempuan) / Itu (Benda, Hewan, Cuaca)\" },\r\n      { \"term\": \"We / They\", \"meaning\": \"Kami (atau Kita) / Mereka\" }\r\n    ],\r\n    \"concept\": \"A subject pronoun is always placed at the beginning of a sentence, before the verb. 'It' is also used for time and weather (e.g., It is raining). Do not assume 'They' is only for humans. If there are two dogs or three books, you still refer to them with 'They'.\",\r\n    \"example_dialogue\": \"I like apples.\\nMy brother is tall. He is a basketball player.\\nLook at the cat. It is very cute.\\nSarah and I are friends. We study together.\"\r\n  },\r\n  {\r\n    \"level\": \"Beginner\",\r\n    \"module_name\": \"Greetings and Introductions\",\r\n    \"sub_topic_title\": \"Reading Practice (A Simple Conversation)\",\r\n    \"objective\": \"Practice all the vocabulary, concepts, and grammar from Sub 1 to Sub 6 in a complete conversational text.\",\r\n    \"vocabulary\": [\r\n      { \"term\": \"Welcome to...\", \"meaning\": \"Selamat datang di...\" },\r\n      { \"term\": \"Everyone\", \"meaning\": \"Semua orang\" },\r\n      { \"term\": \"Excellent\", \"meaning\": \"Luar biasa / Bagus sekali\" }\r\n    ],\r\n    \"concept\": \"[Concept Review] This text combines the use of formal greetings (to a teacher) and informal ones (between friends), the pattern of mentioning one's country of origin, the use of formal titles followed by last names, and the application of subject pronouns.\",\r\n    \"example_dialogue\": \"Lisa: Hi there! I am Lisa. What's your name?\\nOmar: Hello, Lisa. My name is Omar. I am from Egypt. And you?\\nLisa: I come from Canada, but I live in New York now.\\n[A teacher enters the classroom]\\nMr. Miller: Good morning, everyone. My name is Robert Miller. Please call me Mr. Miller. How is everyone doing today?\\nLisa & Omar: Good morning, Mr. Miller. We are doing great, thank you!\"\r\n  }\r\n]",
